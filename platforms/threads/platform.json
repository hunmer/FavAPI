{
  "platform": "threads",
  "display_name": "Threads",
  "icon": "favicon.ico",
  "home_url": "https://www.threads.com/saved",
  "login_cookies": ["sessionid", "ds_user_id", "Session"],
  "proxy": "auto",
  "supported_actions": ["list_favorites"],
  "headers": {
    "x-ig-app-id": "238260118697367",
    "x-fb-friendly-name": "BarcelonaSavedPageRefetchableQuery"
  },
  "capture": {
    "url_contains": "/graphql/query",
    "page_url": "https://www.threads.com/saved",
    "wait_ms": 5000,
    "max_rounds": 12,
    "scroll_step": 2200,
    "scroll_wait_ms": 1800,
    "items_path": "data.xdt_text_app_viewer.saved_media.edges[].node.thread_items[].post",
    "cursor_path": "data.xdt_text_app_viewer.saved_media.page_info.end_cursor",
    "has_more_path": "data.xdt_text_app_viewer.saved_media.page_info.has_next_page",
    "fields": {
      "content_id": "pk",
      "title": "caption.text",
      "description": "caption.text",
      "author_id": "user.id",
      "author_name": "user.username",
      "cover_url": "image_versions2.candidates[].url"
    }
  }
}
