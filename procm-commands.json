{
  "commands": {
    "server": {
      "script": ".venv/Scripts/python.exe",
      "args": ["main.py"],
      "desc": "启动 FavAPI 服务（127.0.0.1:8300）"
    },
    "dev": {
      "script": ".venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.server:app", "--host", "127.0.0.1", "--port", "8300", "--reload"],
      "desc": "开发模式（热重载）启动 FavAPI 服务"
    },
    "test-parser": {
      "script": ".venv/Scripts/python.exe",
      "args": ["tests/test_parser.py"],
      "desc": "抖音解析器单元测试"
    },
    "test-smoke": {
      "script": ".venv/Scripts/python.exe",
      "args": ["tests/smoke_test.py"],
      "desc": "API + 数据层冒烟测试（自动使用临时数据目录，不依赖浏览器）"
    },
    "install-browser": {
      "script": ".venv/Scripts/python.exe",
      "args": ["-m", "playwright", "install", "chromium"],
      "desc": "安装 Playwright Chromium 浏览器内核（首次使用前必须执行一次）"
    }
  }
}
